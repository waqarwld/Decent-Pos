# Staging Environment Configuration

# Database connection settings
export DB_NAME="inventory_management_staging"
export DB_USER="inventory_app"
export DB_HOST="db.staging.example.com"
export DB_PORT="5432"

# Optional: Set password via environment variable
# export PGPASSWORD="staging_password_here"

# Deployment options
export LOAD_SAMPLE_DATA="true"
export RUN_VALIDATION="true"
export CREATE_BACKUP="true"

# Logging
export LOG_LEVEL="INFO"
