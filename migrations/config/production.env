# Production Environment Configuration

# Database connection settings
export DB_NAME="inventory_management"
export DB_USER="inventory_app"
export DB_HOST="db.production.example.com"
export DB_PORT="5432"

# Optional: Set password via environment variable or use .pgpass file
# export PGPASSWORD="secure_password_here"

# Deployment options
export LOAD_SAMPLE_DATA="false"
export RUN_VALIDATION="true"
export CREATE_BACKUP="true"

# Logging
export LOG_LEVEL="INFO"

# Safety settings
export REQUIRE_CONFIRMATION="true"
